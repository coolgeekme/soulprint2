{
  "manifest_version": 3,
  "name": "SoulPrint - AI Chat Sidebar",
  "version": "1.0.0",
  "description": "Ask questions, summarize pages, and use SoulPrint without leaving your current tab.",
  "author": "SoulPrint Engine",
  "homepage_url": "https://soulprintengine.ai",
  "icons": { "16": "icons/icon-48.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Open SoulPrint", "default_icon": { "16": "icons/icon-48.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" } },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle" }],
  "permissions": ["storage", "activeTab", "contextMenus", "identity"],
  "host_permissions": ["https://soulprintengine.ai/*", "http://localhost:3000/*"],
  "commands": { "toggle-sidebar": { "suggested_key": { "default": "Ctrl+Shift+S", "mac": "Command+Shift+S" }, "description": "Toggle SoulPrint sidebar" } },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
